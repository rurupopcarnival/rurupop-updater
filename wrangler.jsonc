{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rurupop-updater",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "update.rurupop.com", "custom_domain": true }],
  "vars": {
    "CF_ACCOUNT_ID": "28ee49cf457ae3b7d3cfdc46859d951f",
    "ACCESS_TEAM_DOMAIN": "REPLACE_ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ME"
  }
  // シークレット（ここには書かない）：GITHUB_TOKEN（対象リポジトリの Contents 読み書き）, CF_API_TOKEN（Workers Builds の読み取り）
}
