    "ACCESS_TEAM_DOMAIN": "little-rain-4859.cloudflareaccess.com",
    "ACCESS_AUD": "2dd87167c7d25e4a9d82245dfd37951eeb34870ea9533cf792fb8877b1c47abc"
  }
  // シークレット（ここには書かない）：GITHUB_TOKEN（対象リポジトリの Contents 読み書き）, CF_API_TOKEN（Workers Builds の読み取り）
}
